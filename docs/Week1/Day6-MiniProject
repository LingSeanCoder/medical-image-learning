# 4. Complete Mini Project

> Cố gắng tự viết trước. Chỉ xem code bên dưới để kiểm tra sau khi hoàn thành.

```python
import torch
import torch.nn as nn
import matplotlib.pyplot as plt


# ============================================================
# 1. Set random seed
# ============================================================
torch.manual_seed(42)


# ============================================================
# 2. Generate dataset
# ============================================================
# True relationship:
# y = 3x + 2 + noise

x = torch.linspace(-5, 5, 200).unsqueeze(1)

noise = 0.5 * torch.randn_like(x)

y = 3.0 * x + 2.0 + noise


# ============================================================
# 3. Train / validation split
# ============================================================
# Use the first 160 samples for training
# Use the remaining 40 samples for validation

train_size = 160

x_train = x[:train_size]
y_train = y[:train_size]

x_val = x[train_size:]
y_val = y[train_size:]


print("Train shape:")
print("x_train:", x_train.shape)
print("y_train:", y_train.shape)

print("\nValidation shape:")
print("x_val:", x_val.shape)
print("y_val:", y_val.shape)


# ============================================================
# 4. Create model
# ============================================================
# Linear regression:
# y = wx + b

model = nn.Linear(1, 1)


# ============================================================
# 5. Loss function
# ============================================================
criterion = nn.MSELoss()


# ============================================================
# 6. Optimizer
# ============================================================
optimizer = torch.optim.SGD(
    model.parameters(),
    lr=0.05
)


# ============================================================
# 7. Training configuration
# ============================================================
epochs = 500

train_losses = []
val_losses = []


# ============================================================
# 8. Training loop
# ============================================================
for epoch in range(epochs):

    # --------------------------------------------------------
    # Training mode
    # --------------------------------------------------------
    model.train()

    # Forward pass
    train_pred = model(x_train)

    # Calculate training loss
    train_loss = criterion(train_pred, y_train)

    # Clear old gradients
    optimizer.zero_grad()

    # Calculate gradients
    train_loss.backward()

    # Update parameters
    optimizer.step()


    # --------------------------------------------------------
    # Validation
    # --------------------------------------------------------
    # No gradient calculation is needed during validation
    model.eval()

    with torch.no_grad():

        val_pred = model(x_val)

        val_loss = criterion(
            val_pred,
            y_val
        )


    # --------------------------------------------------------
    # Save losses
    # --------------------------------------------------------
    train_losses.append(train_loss.item())
    val_losses.append(val_loss.item())


    # --------------------------------------------------------
    # Print progress
    # --------------------------------------------------------
    if epoch % 100 == 0:

        print(
            f"Epoch {epoch:03d} | "
            f"Train Loss: {train_loss.item():.4f} | "
            f"Val Loss: {val_loss.item():.4f}"
        )


# ============================================================
# 9. Get learned parameters
# ============================================================
weight = model.weight.item()
bias = model.bias.item()


# ============================================================
# 10. Final evaluation
# ============================================================
model.eval()

with torch.no_grad():

    train_pred = model(x_train)
    val_pred = model(x_val)

    final_train_loss = criterion(
        train_pred,
        y_train
    ).item()

    final_val_loss = criterion(
        val_pred,
        y_val
    ).item()


# ============================================================
# 11. Plot train / validation loss
# ============================================================
plt.figure(figsize=(7, 4))

plt.plot(
    train_losses,
    label="Train Loss"
)

plt.plot(
    val_losses,
    label="Validation Loss"
)

plt.xlabel("Epoch")
plt.ylabel("MSE Loss")
plt.title("Training and Validation Loss")

plt.legend()
plt.grid(True)

plt.savefig(
    "loss_curve.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


# ============================================================
# 12. Plot predictions
# ============================================================
with torch.no_grad():

    all_pred = model(x)


plt.figure(figsize=(7, 4))

plt.scatter(
    x_train.numpy(),
    y_train.numpy(),
    s=15,
    label="Train Data"
)

plt.scatter(
    x_val.numpy(),
    y_val.numpy(),
    s=15,
    label="Validation Data"
)

plt.plot(
    x.numpy(),
    all_pred.numpy(),
    label="Model Prediction"
)

plt.xlabel("x")
plt.ylabel("y")
plt.title("Linear Regression Prediction")

plt.legend()
plt.grid(True)

plt.savefig(
    "prediction.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


# ============================================================
# 13. Summary
# ============================================================
print("\n" + "=" * 50)
print("PROJECT SUMMARY")
print("=" * 50)

print(f"True function:       y = 3x + 2 + noise")
print(f"Learned weight:      {weight:.4f}")
print(f"Learned bias:        {bias:.4f}")
print(f"Final train loss:    {final_train_loss:.4f}")
print(f"Final validation loss: {final_val_loss:.4f}")

print("\nSaved figures:")
print("- loss_curve.png")
print("- prediction.png")
```

